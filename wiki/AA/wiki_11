 DO
 INPUT "Chcete vic hvezdicek"; Answer$
 LOOP UNTIL Answer$ &lt;&gt; ""
 Answer$ = LEFT$(Answer$, 1)
LOOP WHILE UCASE$(Answer$) = "A"
PRINT "Nashledanou ";
FOR I = 1 TO 200
