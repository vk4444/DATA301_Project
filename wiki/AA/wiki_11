 90 A$ = LEFT$(A$, 1)
100 IF (A$ = "A") OR (A$ = "a") THEN GOTO 30
110 PRINT "Nashledanou ";
120 FOR I = 1 TO 200
130 PRINT U$; " ";
140 NEXT I
150 PRINT
