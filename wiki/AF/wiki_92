 if_nz r0.x // &lt;--- POZOR! Opravdu bylo záměrem vytvořit větvení?
 mov o0.xyzw, v0.xyzw
 ret 
 else 
 mov o0.xyzw, v0.wzyx
 ret 
 endif 
