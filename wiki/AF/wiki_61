 sum.set(re+c2.get_re(), im+c2.get_im());
 return sum;
Complex Complex::get_sum(double re2){
 Complex sum;
 sum.set(re + re2, im);
 return sum;
int main(){
 Complex n1, n2, sum;
 double re;
 sum = n1.get_sum(n2); // Tady se vola prvni metoda
