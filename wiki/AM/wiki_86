foo(); // 2
alert('volání na g(): ' + g()); // 1 (--x)
alert('volání na g(): ' + g()); // 0 (--x)
alert('volání na f(): ' + f()); // 1 (++x)
alert('volání na f(): ' + f()); // 2 (++x)
