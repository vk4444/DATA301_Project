std::unique_ptr&lt;int&gt; p2 = p1; // Způsobí chybu při překladu
std::unique_ptr&lt;int&gt; p3 = std::move(p1); // Předá vlastnictví. p3 nyní vlastní paměť a p1 je nullptr.
