 &lt;xs:enumeration value="Cervenec"/&gt;
 &lt;xs:enumeration value="Srpen"/&gt;
 &lt;xs:enumeration value="Zari"/&gt;
 &lt;xs:enumeration value="Rijen"/&gt;
