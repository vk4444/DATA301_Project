int
main(void)
 /* Length of the password */
 unsigned short int length = 8;
 /* Seed number for rand() */
 srand((unsigned int) time(0) + getpid());
 /* ASCII characters 33 to 126 */
 while(length--) {
 putchar(rand() % 94 + 33);
 srand(rand());
 printf("\n");
 return EXIT_SUCCESS;
