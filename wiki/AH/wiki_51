 $ lsof /var
 COMMAND PID USER FD TYPE DEVICE SIZE/OFF NODE NAME
 syslogd 350 root 5w VREG 222,5 0 440818 /var/adm/messages
 syslogd 350 root 6w VREG 222,5 339098 6248 /var/log/syslog
